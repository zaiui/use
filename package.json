{
    "name": "@zaiui/use",
    "type": "module",
    "version": "1.0.5",
    "description": "JavaScript / TypeScript 工具函数库",
    "scripts": {
        "dev": "tsup-node --watch",
        "build": "tsup-node && tsc -p tsconfig.dts.json",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit",
        "link": "yarn link",
        "unlink": "yarn unlink"
    },
    "sideEffects": [
        "./packages/to/dayjs.ts"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "AGENTS.md",
        "templates",
        "LICENSE",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/zaiui/use.git"
    },
    "homepage": "https://github.com/zaiui/use#readme",
    "bugs": {
        "url": "https://github.com/zaiui/use/issues"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "dependencies": {
        "dayjs": "^1.11.19"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "rimraf": "^6.1.2",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2"
    },
    "author": "iZaiZaiA<https://github.com/iZaiZaiA>",
    "copyright": "Copyright © 2026 iZaiZaiA And @zaiui/use",
    "license": "MIT",
    "keywords": [
        "library",
        "tools",
        "utils",
        "hook",
        "vue",
        "typescript"
    ]
}
